{
  "name": "linkslope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test --test-isolation=none",
    "test:coverage": "node --test --test-isolation=none --experimental-test-coverage --test-coverage-include=src/**",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:site": "node scripts/test-site.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.3.3",
    "linkedom": "^0.18.13",
    "tailwindcss": "^4.3.3",
    "vite": "^7.0.0"
  }
}
